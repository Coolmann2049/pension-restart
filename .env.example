# Core application
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/pension-restart.db
SESSION_SECRET=replace-with-at-least-32-random-characters
CASE_CODE_SECRET=replace-with-another-32-random-character-secret
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
DATA_RETENTION_DAYS=30

# OpenAI interpretation agent. If absent, a local conservative interpreter is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Vapi
VAPI_PRIVATE_API_KEY=
VAPI_PUBLIC_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_PHONE_NUMBER_DISPLAY=
# ID of the Vapi Server Configuration credential that sends the secret below as a Bearer token.
VAPI_SERVER_CREDENTIAL_ID=
VAPI_WEBHOOK_SECRET=
VAPI_MODEL=gpt-5.4-mini
VAPI_VOICE_ID=Naina

# Meta WhatsApp Cloud API
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_STATUS_TEMPLATE_NAME=
WHATSAPP_STATUS_TEMPLATE_LANGUAGE=en
